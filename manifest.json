{
  "manifest_version": 3,
  "name": "Ollama Cloud Usage",
  "version": "1.0.0",
  "description": "See your Ollama Cloud session and weekly usage from the Chrome toolbar.",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ollama.com/*"
  ],
  "action": {
    "default_title": "Ollama Cloud Usage",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
